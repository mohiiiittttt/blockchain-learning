// Users cannot withdraw funds until a specific date.

contract TimeVault {
    
    address public owner;
    uint256 public unlockDate;

    // CONSTRUCTOR: Runs once when we deploy.
    // We set how many days to lock the funds.
    constructor(uint256 _daysToLock) payable {
        owner = msg.sender;
        
        // BLOCK.TIMESTAMP: The current time on the blockchain.
        // We add the days to lock to the current time.
        unlockDate = block.timestamp + (_daysToLock * 1 days);
    }

    // WITHDRAW: Only works AFTER the date has passed.
    function withdraw() public {
        // 1. Check if it's the owner
        require(msg.sender == owner, "Not your vault");
        
        // 2. Check if the time is up
        require(block.timestamp >= unlockDate, "Funds are still locked");

        // 3. Transfer everything back (Modern Way)
        (bool success, ) = payable(owner).call{value: address(this).balance}("");
        require(success, "Transfer failed");
    }

    // HELPER: Check how much is in the vault
    function getBalance() public view returns (uint256) {
        return address(this).balance;
    }
}
